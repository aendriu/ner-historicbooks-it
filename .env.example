# HistoricBook Pipeline — esempio di configurazione
# Copia questo file in .env e modifica i valori

# ── Ollama (LLM per pulizia OCR) ──────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b

# ── NER ───────────────────────────────────────────────────────────────────
NER_MODEL_NAME=aendriu/bert-ner-italian-historical
NER_SCORE_THRESHOLD=0.65
NER_MIN_ENTITY_CHARS=3

# ── Chunking Semantico ─────────────────────────────────────────────────────
SEMANTIC_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_SIMILARITY_THRESHOLD=0.5

# ── Database ───────────────────────────────────────────────────────────────
DB_FILENAME=historicbooks.db
