# ─── Configurazione del modello LLM ───
OLLAMA_HOST=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:9b

# ─── Modelli NER e Semantic ───
NER_MODEL_NAME=aendriu/bert-ner-italian-historical
NER_SCORE_THRESHOLD=0.65
NER_MIN_ENTITY_CHARS=3

SEMANTIC_EMBEDDING_MODEL=bge-m3
SEMANTIC_SIMILARITY_THRESHOLD=0.5

# ─── Database Locale ───
DB_FILENAME=historicbooks.db

# ─── Testing (opzionale) ───
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=inserisci_qui_la_tua_api_key
